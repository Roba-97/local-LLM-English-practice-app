<div id="assist_result" class="mt-3">
  <% if assist_request.suggestion.present? %>
    <div class="card">
      <div class="card-body"><%= simple_format(assist_request.suggestion, class: "mb-1") %></div>
    </div>
  <% elsif assist_request.errors.any? %>
    <div class="alert alert-danger"><%= assist_request.errors.full_messages.to_sentence %></div>
  <% else %>
    <p class="text-secondary small">考え中...</p>
  <% end %>
</div>
