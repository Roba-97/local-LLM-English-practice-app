<%= turbo_frame_tag "message_form" do %>
  <%= form_with model: message, url: chat_room_messages_path(chat_room), class: "mt-3" do |f| %>
    <% if message.errors.any? %>
      <div class="alert alert-danger py-2">
        <%= message.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="d-flex gap-2 align-items-end">
      <%= f.text_area :content, rows: 2, maxlength: Message::MAX_LENGTH, class: "form-control",
                      placeholder: "Type your reply in English", "aria-label": "メッセージ" %>
      <%= f.submit "送信", class: "btn btn-primary flex-shrink-0", data: { turbo_submits_with: "送信中..." } %>
    </div>
  <% end %>
<% end %>
