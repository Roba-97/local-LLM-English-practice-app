<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">チャットルーム</h1>
  <%= link_to "新しいルームを作る", new_chat_room_path, class: "btn btn-primary" %>
</div>

<% if @chat_rooms.any? %>
  <div class="list-group">
    <% @chat_rooms.each do |chat_room| %>
      <%= link_to chat_room, class: "list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-3" do %>
        <span class="text-truncate"><%= chat_room.situation %></span>
        <span class="badge text-bg-secondary flex-shrink-0"><%= level_label(chat_room.level) %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-secondary">まだルームがありません。シチュエーションを決めて、最初のルームを作りましょう。</p>
<% end %>
