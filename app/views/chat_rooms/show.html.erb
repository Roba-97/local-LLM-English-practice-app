<%= turbo_stream_from @chat_room %>

<div class="mb-4">
  <%= link_to "← ルーム一覧", chat_rooms_path, class: "link-secondary small" %>
  <div class="d-flex align-items-center gap-2 mt-2">
    <span class="badge text-bg-secondary"><%= level_label(@chat_room.level) %></span>
    <h1 class="h5 mb-0"><%= @chat_room.situation %></h1>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div id="messages">
      <%= render @messages %>
    </div>
    <%= render "chat_rooms/reply_status", status: @chat_room.awaiting_reply? ? :pending : :idle %>
  </div>

  <aside class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <h2 class="h6">お助け機能</h2>
        <p class="text-secondary small">言いたいことを日本語で書くと、そのまま使える英文を提案します。</p>
        <%= render "chat_rooms/assists/form", chat_room: @chat_room, assist_request: @assist_request, request_id: nil %>
      </div>
    </div>
  </aside>
</div>
