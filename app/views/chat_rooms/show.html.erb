<%= turbo_stream_from @chat_room %>

<div class="mb-4">
  <%= link_to "← ルーム一覧", chat_rooms_path, class: "link-secondary small" %>
  <div class="d-flex align-items-center gap-2 mt-2">
    <span class="badge text-bg-secondary"><%= level_label(@chat_room.level) %></span>
    <h1 class="h5 mb-0"><%= @chat_room.situation %></h1>
  </div>
</div>

<div id="messages">
  <%= render @messages %>
</div>
<%= render "chat_rooms/reply_status", status: @chat_room.awaiting_reply? ? :pending : :idle %>
