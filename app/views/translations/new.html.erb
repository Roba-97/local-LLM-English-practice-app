<h1>お助け機能</h1>
<p class="text-secondary">言いたいことを日本語で書くと、そのまま使える英文を提案します。</p>

<%= turbo_frame_tag "assist" do %>
  <%= form_with model: @assist_request, url: translation_path do |f| %>
    <% if @assist_request.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @assist_request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :message, "言いたいこと", class: "form-label" %>
      <%= f.text_area :message, rows: 3, maxlength: AssistRequest::MAX_LENGTH, class: "form-control",
                      placeholder: "例: おすすめのコーヒーを聞きたい" %>
    </div>

    <%= f.submit "英文を提案してもらう", class: "btn btn-primary", data: { turbo_submits_with: "考え中..." } %>
  <% end %>

  <% if @request_id %>
    <%= turbo_stream_from "assist", @request_id %>
    <%= render "result", assist_request: @assist_request %>
  <% end %>
<% end %>
